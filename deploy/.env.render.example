# Reference environment for the Render free-tier deploy (render.yaml).
# Values are set by the Blueprint / dashboard; this file is documentation only.

APP_NAME=Ayyanet
APP_ENV=production
APP_KEY=base64:REPLACE-WITH-php-artisan-key:generate---show-output
APP_DEBUG=false
APP_URL=https://ayyanet-ticketing.onrender.com

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

# Postgres connection string, wired automatically by render.yaml (DB_URL
# fromDatabase -> connectionString). No separate DB_HOST/USER/PASSWORD needed.
DB_CONNECTION=pgsql
DB_URL=postgresql://ayyanet:***@host:5432/ayyanet

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# ---- Email (optional) -----------------------------------------------------
# Render FREE web services cannot send SMTP on ports 25/465/587.
# Resend supports 2465 (implicit TLS) and 2587 (STARTTLS) instead:
#   MAIL_PORT=2587  MAIL_ENCRYPTION=tls   (or 2465 + ssl)
# Until these are set, mail falls back to the "log" mailer (see config/mail.php).
MAIL_MAILER=log
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.resend.com
# MAIL_PORT=2587
# MAIL_USERNAME=resend
# MAIL_PASSWORD=re_YOUR_API_KEY
# MAIL_ENCRYPTION=tls
# MAIL_FROM_ADDRESS=you@your-verified-domain.com
# MAIL_FROM_NAME="${APP_NAME}"
