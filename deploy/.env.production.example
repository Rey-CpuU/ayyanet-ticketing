# Production environment for the Koyeb free-tier deploy (see README).
# Reference for the env vars you set on the Koyeb service.

APP_NAME=Ayyanet
APP_ENV=production
APP_KEY=base64:REPLACE-WITH-php-artisan-key:generate---show-output
APP_DEBUG=false
# Koyeb assigns <app>-<org>.koyeb.app. Replace after first deploy if different.
APP_URL=https://ayyanet-ticketing.koyeb.app

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Neon free Postgres. Laravel 13 reads the whole connection string from DB_URL,
# so the individual DB_* variables below are not needed.
# Get this from Neon: Project -> Connection Details -> "Connection string".
DB_CONNECTION=pgsql
DB_URL=postgresql://USER:PASSWORD@HOST.neon.tech/neondb?sslmode=require

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

# Email (optional) - Resend SMTP works on Koyeb free (ports 25/465/587 allowed).
MAIL_MAILER=log
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.resend.com
# MAIL_PORT=587
# MAIL_USERNAME=resend
# MAIL_PASSWORD=re_YOUR_API_KEY
# MAIL_ENCRYPTION=tls
# MAIL_FROM_ADDRESS=you@your-verified-domain.com
# MAIL_FROM_NAME=Ayyanet

# First boot only: set APP_SEED=true to load demo data, then remove it.
# The seeder wipes tickets/customers, so never leave it on.
# APP_SEED=true
