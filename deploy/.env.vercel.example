# Environment variables for the Vercel deploy (see README "Deploy to Vercel").
# Set these in the Vercel dashboard: Project -> Settings -> Environment Variables.

APP_NAME=Ayyanet
APP_ENV=production
APP_KEY=base64:REPLACE-WITH-php-artisan-key:generate---show-output
APP_DEBUG=false
# Vercel assigns <project>.vercel.app. Adjust if different.
APP_URL=https://ayyanet-ticketing.vercel.app

# Neon free Postgres (Laravel 13 reads the whole connection string from DB_URL).
DB_CONNECTION=pgsql
DB_URL=postgresql://USER:PASSWORD@HOST.neon.tech/neondb?sslmode=require

# Serverless-safe drivers: everything lives in the database (no disk writes).
SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# The Vercel function filesystem is read-only (except /tmp), so:
#  - logs go to stderr (captured by Vercel)
#  - compiled Blade views go to /tmp
#  - the package manifest can be rebuilt into /tmp
LOG_CHANNEL=stderr
VIEW_COMPILED_PATH=/tmp/views
APP_PACKAGES_CACHE=/tmp/packages.php

# Demo data on ONE deploy only: set to true, deploy, then remove it.
# The seeder wipes tickets/customers, so never leave it on.
# APP_SEED=true

# Email (optional) - Resend SMTP works fine on Vercel.
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.resend.com
# MAIL_PORT=587
# MAIL_USERNAME=resend
# MAIL_PASSWORD=re_YOUR_API_KEY
# MAIL_ENCRYPTION=tls
# MAIL_FROM_ADDRESS=you@your-verified-domain.com
# MAIL_FROM_NAME=Ayyanet
