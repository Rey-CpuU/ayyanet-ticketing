APP_NAME=Laravel
APP_ENV=local
APP_KEY=
# ⚠️  Set APP_DEBUG=false in production. Keeping it true exposes full
#     stack traces (including local filesystem paths and request input
#     such as email/password) to every visitor on any error.
APP_DEBUG=true
APP_URL=http://localhost

# Timestamps are stored in this timezone. Production data is stored in UTC;
# only change it on a fresh database.
APP_TIMEZONE=UTC

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3307
# DB_DATABASE=ayyanet_ticketing
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-gmail@gmail.com
MAIL_PASSWORD=your-gmail-app-password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="your-gmail@gmail.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# SLA window per priority (e.g. 5h, 90m, 1d). Overdue tickets are flagged by
# `php artisan tickets:check-sla`, scheduled every five minutes (needs schedule:run).
SLA_HIGH=5h
SLA_MEDIUM=8h
SLA_LOW=24h

TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_ALLOWED_CHAT_IDS=
TELEGRAM_DEFAULT_ADMIN_ID=

TELEGRAM_NOTIF_BOT_TOKEN=
TELEGRAM_NOTIF_GROUP_ID=
TELEGRAM_NOTIF_ENABLED=true
